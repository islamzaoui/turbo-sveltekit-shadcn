{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"prepare": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*", "!.env.example"]
		},
		"preview": {
			"cache": false,
			"persistent": false
		},
		"typecheck": {
			"inputs": [
				"src/**/*.{js,ts,jsx,tsx,svelte,d.ts}",
				"tsconfig.json",
				"tsconfig.*.json",
				"package.json"
			]
		}
	}
}
