{
	"extends": ["./.svelte-kit/tsconfig.json", "@repo/tsconfig/svelte"],
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"allowArbitraryExtensions": true,
		"strictNullChecks": true,
		"types": ["svelte"]
	},
	"include": ["src/**/*.js", "src/**/*.ts", "src/**/*.svelte"],
	"exclude": ["node_modules", ".svelte-kit", "dist"]
}
