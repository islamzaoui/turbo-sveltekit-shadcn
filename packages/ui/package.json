{
	"name": "@repo/ui",
	"private": true,
	"type": "module",
	"exports": {
		"./components/forms": {
			"types": "./dist/components/forms/index.d.ts",
			"svelte": "./dist/components/forms/index.js",
			"default": "./dist/components/forms/index.js"
		},
		"./components/cn/separator": {
			"types": "./dist/components/cn/separator/index.d.ts",
			"svelte": "./dist/components/cn/separator/index.js",
			"default": "./dist/components/cn/separator/index.js"
		},
		"./components/cn/label": {
			"types": "./dist/components/cn/label/index.d.ts",
			"svelte": "./dist/components/cn/label/index.js",
			"default": "./dist/components/cn/label/index.js"
		},
		"./components/cn/input": {
			"types": "./dist/components/cn/input/index.d.ts",
			"svelte": "./dist/components/cn/input/index.js",
			"default": "./dist/components/cn/input/index.js"
		},
		"./components/cn/field": {
			"types": "./dist/components/cn/field/index.d.ts",
			"svelte": "./dist/components/cn/field/index.js",
			"default": "./dist/components/cn/field/index.js"
		},
		"./components/cn/button": {
			"types": "./dist/components/cn/button/index.d.ts",
			"svelte": "./dist/components/cn/button/index.js",
			"default": "./dist/components/cn/button/index.js"
		},
		"./utils": {
			"types": "./dist/utils.d.ts",
			"default": "./dist/utils.js"
		},
		"./style.css": "./dist/style.css"
	},
	"sideEffects": [
		"dist/style.css"
	],
	"scripts": {
		"prepare": "svelte-kit sync || echo ''",
		"dev": "svelte-kit sync && svelte-package --input src --output dist --watch",
		"build": "svelte-kit sync && svelte-package --input src --output dist && tsx scripts/exports.ts",
		"exports:watch": "tsx scripts/exports.ts --watch",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"ui": "bun shadcn-svelte"
	},
	"devDependencies": {
		"@fontsource-variable/geist": "5.2.9",
		"@repo/tsconfig": "workspace:*",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/package": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"bits-ui": "^2.16.3",
		"bun-types": "catalog:",
		"chokidar": "5.0.0",
		"clsx": "2.1.1",
		"glob": "13.0.6",
		"shadcn-svelte": "1.2.7",
		"svelte-check": "catalog:",
		"tailwind-merge": "3.6.0",
		"tailwind-variants": "3.2.2",
		"tsx": "4.22.0",
		"tw-animate-css": "1.4.0",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"@lucide/svelte": "catalog:",
		"@internationalized/date": "catalog:",
		"svelte": "catalog:",
		"tailwindcss": "catalog:"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"svelte"
	]
}
