{
	"name": "monorepo",
	"description": "Turborepo sveltekit starter with shadcn pre-configured",
	"packageManager": "bun@1.3.13",
	"private": true,
	"scripts": {
		"prepare": "(husky || echo '') && turbo prepare",
		"dev": "turbo dev",
		"build": "turbo build",
		"preview": "turbo preview",
		"typecheck": "turbo typecheck",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"ui": "bun --cwd packages/ui ui"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"husky": "9.1.7",
		"lint-staged": "17.0.5",
		"turbo": "2.9.14"
	},
	"workspaces": {
		"packages": [
			"packages/*",
			"apps/*"
		],
		"catalog": {
			"bun-types": "1.3.13",
			"typescript": "^6",
			"tailwindcss": "4.3.0",
			"@internationalized/date": "3.12.1"
		},
		"catalogs": {
			"svelte": {
				"@tailwindcss/vite": "4.3.0",
				"vite": "8.0.13",
				"@sveltejs/adapter-auto": "7.0.1",
				"@sveltejs/kit": "2.60.1",
				"@sveltejs/vite-plugin-svelte": "7.1.2",
				"svelte-check": "4.4.8",
				"svelte": "5.55.7",
				"@sveltejs/package": "2.5.7",
				"@tsconfig/svelte": "5.0.8",
				"@lucide/svelte": "1.16.0"
			}
		}
	},
	"lint-staged": {
		"*": "biome check --write"
	}
}
